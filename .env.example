# --- Обязательное ---
# Ключи Gemini (можно несколько через запятую — будет ротация при ошибках)
GEMINI_API_KEYS=ключ1,ключ2

# Токен бота из @BotFather
SHELLY_TG_TOKEN=123456:ABC...

# Telegram ID пользователя, которому разрешено общаться с Шелли
SHELLY_ADMIN_ID=123456789

# --- Персона ---
SHELLY_USER_NAME=хозяин
# Можно переопределить приветствие целиком:
# SHELLY_GREETING=Здравствуй, хозяин. Что случилось?

# --- Поведение ---
SHELLY_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.7-flash
SHELLY_WORKDIR=/root
SHELLY_STEP_LIMIT=12
SHELLY_HISTORY_LIMIT=40
SHELLY_COMMAND_TIMEOUT=120
SHELLY_CONFIRM_TIMEOUT=180
# Rich-draft живёт ~30 сек; после этого порога включаем обычное сообщение
SHELLY_LONG_REQUEST_AFTER=20

# Маскировать секреты в выводе команд, логах и сообщениях (рекомендуется):
SHELLY_MASK_SECRETS=1
# Автозапуск Шелли при интерактивном входе по SSH; меняется командой /terminal в боте:
SHELLY_TERMINAL_AUTOSTART=1
# Требовать подтверждение для ЛЮБОЙ команды, а не только опасной:
# SHELLY_CONFIRM_ALL=0

# Анимация размышления в Telegram (премиум-эмодзи)
SHELLY_THINK_EMOJI=5427181942934088912
SHELLY_THINK_EMOJI_CHAR=💬

# --- Пути (по умолчанию рядом с пакетом) ---
# SHELLY_LOG_PATH=/var/log/shelly/tools.log
# SHELLY_ENV_FILE=/etc/shelly/.env

# --- Дополнительно ---
# Ссылка на репозиторий — показывается в /about и /install:
# SHELLY_PROJECT_URL=https://github.com/namematthew-cyber/shelly

# Свой список опасных команд через запятую (перекрывает встроенный):
# SHELLY_DANGEROUS_PATTERNS=rm -rf,mkfs,shutdown
